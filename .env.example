# VLH-CTF compose environment — copy to .env and adjust.
# Referenced by docker-compose.yml interpolation (see header of that file).

# M1 edge-front desync flavor: cl-te | te-cl | te-te
EDGE_MODE=cl-te

# M0 Postgres credentials (full mode only; collector activity archive).
POSTGRES_USER=vlh
POSTGRES_PASSWORD=vlh
POSTGRES_DB=vlh

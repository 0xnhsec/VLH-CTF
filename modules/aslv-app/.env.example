# VLH-CTF ASLV M3 — aslv-app environment (copied to .env by entrypoint.sh;
# APP_KEY is generated at container start).
#
# Session cookie domain (.aslv.lab via config/session.php) is deliberate: the
# session is shared across tenant subdomains — that is what makes the M3 IDOR
# playable (log in anywhere, browse the innocent's tenant subdomain with the
# same cookie).

APP_KEY=
APP_ENV=production
APP_DEBUG=false
APP_URL=

DB_CONNECTION=sqlite
DB_DATABASE=/data/app.db

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Nothing in this module uses the cache, but Laravel 11's framework-default
# cache store is 'database' (needs a cache table we do not ship) — pin 'file'
# so any future cache consumer works out of the box.
CACHE_STORE=file

LOG_CHANNEL=stderr
